// Icon and version details for StreamLens.exe (shown in Explorer, the taskbar and Apps & features).
#include <winver.h>

1 ICON "streamlens.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "StreamLens"
            VALUE "FileDescription", "StreamLens: phone camera for OBS"
            VALUE "FileVersion", "0.2.0"
            VALUE "ProductName", "StreamLens"
            VALUE "ProductVersion", "0.2.0"
            VALUE "OriginalFilename", "StreamLens.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
